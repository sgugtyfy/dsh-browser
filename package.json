{
  "name": "dsh-browser",
  "version": "0.1.1",
  "description": "DSH 原生浏览器控制插件：直接操作你本机已登录的 Chrome / Edge（CDP，零依赖，含 MCP 适配器）",
  "type": "module",
  "main": "./lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgugtyfy/dsh-browser.git"
  },
  "homepage": "https://github.com/sgugtyfy/dsh-browser#readme",
  "bugs": {
    "url": "https://github.com/sgugtyfy/dsh-browser/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "browser",
    "cdp",
    "chrome",
    "edge"
  ],
  "files": [
    "lib",
    "mcp",
    "test",
    "cordis.patch.yml",
    "install.mjs",
    "uninstall.mjs",
    "install.cmd",
    "uninstall.cmd",
    "launch-chrome.cmd",
    "launch-edge.cmd",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "selftest": "node mcp/server.mjs --selftest",
    "test:e2e": "node test/e2e.mjs"
  }
}
